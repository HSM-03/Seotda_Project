<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="seotda.LoginController">

    <center>
        <StackPane prefWidth="1100" prefHeight="700" BorderPane.alignment="CENTER">

            <!-- 🎴 배경 이미지 -->
            <ImageView fitWidth="1100" fitHeight="700" preserveRatio="true">
                <image>
                    <Image url="@/seotda/LoginBackground/login.png" />
                </image>
            </ImageView>

            <!-- 🔐 로그인 카드 -->
            <VBox alignment="CENTER" spacing="16"
                  maxWidth="420"
                  StackPane.alignment="CENTER"
                  translateY="130"
                  style="-fx-background-color: transparent;
                         -fx-background-radius: 28;
                         -fx-padding: 26 34;
                         -fx-border-color: transparent;
                         -fx-border-radius: 28;
                         -fx-border-width: 0;">
                <effect>
                    <DropShadow radius="20" offsetY="6"
                                color="rgba(0,0,0,0.8)"/>
                </effect>

                <!-- 아이디 입력 -->
                <TextField fx:id="idField"
                           promptText="아이디 입력"
                           prefWidth="360"
                           style="
                               -fx-background-color: rgba(255,255,255,0.08);
                               -fx-text-fill: #FDFDFD;
                               -fx-prompt-text-fill: rgba(240,240,240,0.55);
                               -fx-background-radius: 20;
                               -fx-border-radius: 20;
                               -fx-border-color: rgba(255, 220, 170, 0.65);
                               -fx-border-width: 1.4;
                               -fx-padding: 8 14;
                               -fx-font-size: 14px;
                           "/>

                <!-- 비밀번호 입력 -->
                <PasswordField fx:id="pwField"
                               promptText="비밀번호 입력"
                               prefWidth="360"
                               style="
                                   -fx-background-color: rgba(255,255,255,0.08);
                                   -fx-text-fill: #FDFDFD;
                                   -fx-prompt-text-fill: rgba(240,240,240,0.55);
                                   -fx-background-radius: 20;
                                   -fx-border-radius: 20;
                                   -fx-border-color: rgba(255, 220, 170, 0.65);
                                   -fx-border-width: 1.4;
                                   -fx-padding: 8 14;
                                   -fx-font-size: 14px;
                               "/>

                <!-- 로그인 버튼 -->
                <Button text="로그인"
                        onAction="#handleLogin"
                        prefWidth="220"
                        style="
                            -fx-background-color: linear-gradient(to right, #D54C4C, #E6843A);
                            -fx-text-fill: white;
                            -fx-font-weight: bold;
                            -fx-font-size: 14px;
                            -fx-background-radius: 20;
                            -fx-cursor: hand;
                            -fx-padding: 8 0;
                            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 12, 0.2, 0, 3);
                        "/>

                <!-- ⭐⭐⭐ 추가된 회원가입 버튼 ⭐⭐⭐ -->
                <Button text="회원가입"
                        onAction="#handleOpenRegister"
                        prefWidth="220"
                        style="
                            -fx-background-color: rgba(255,255,255,0.2);
                            -fx-text-fill: #FDFDFD;
                            -fx-font-weight: bold;
                            -fx-font-size: 13px;
                            -fx-background-radius: 20;
                            -fx-border-radius: 20;
                            -fx-cursor: hand;
                            -fx-padding: 6 0;
                            -fx-border-color: rgba(255,220,170,0.65);
                            -fx-border-width: 1.3;
                        "/>
                <!-- ⭐⭐⭐ 여기까지 추가 ⭐⭐⭐ -->

                <!-- 상태 표시 -->
                <Label fx:id="loginStatusLabel" text=""
                       style="-fx-text-fill: #ffb3b3;
                              -fx-font-size: 12px;
                              -fx-font-weight: bold;"/>

            </VBox>

        </StackPane>
    </center>

</BorderPane>
